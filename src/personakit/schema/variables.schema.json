{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/malkreide/personakit/schema/variables.schema.json",
  "title": "personakit Verhaltensvariablen einer Studie",
  "description": "factoids/<studie>/variables.yml: die Skalen, auf denen die Factoids einer Studie Teilnehmende verorten. Optional; ist die Datei vorhanden, sind nur diese Variablen erlaubt, und ihre Anker gehen ins Persona-Skelett.",
  "type": "object",
  "additionalProperties": false,
  "required": ["personakit", "variables"],
  "properties": {
    "personakit": {
      "type": "string",
      "const": "1.0"
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "low": { "type": "string", "description": "Anker für Wert 1." },
          "high": { "type": "string", "description": "Anker für Wert 5." }
        }
      }
    }
  }
}
